STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SETTLEMENT_CONTRACT_ID=
# Uploaded `contracts/wallet` WASM hash required for smart-wallet provisioning.
STELLAR_WALLET_WASM_HASH=
# Exact decimal XLM amount, up to seven fractional digits. Defaults to 25.
STELLAR_WALLET_FUNDING=25
API_PORT=4100
API_HOST=127.0.0.1
# Fail closed on anonymous mutations; leave unset for the local emulator flow.
API_AUTH_REQUIRED=false
# HMAC key for 15-minute device sessions. Required with API_AUTH_REQUIRED=true;
# use at least 32 random bytes and keep it in the deployment secret store.
API_SESSION_SECRET=
# Refuse to start on in-memory storage (production deployments).
API_REQUIRE_DATABASE=false
# Durable storage for the API and the worker; unset keeps both in emulator mode.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Relayer that pays settlement fees, and the contract admin that registers
# merchants. Without them the API reports 503 for the relayer routes and the
# mobile app stays in demo mode.
STELLAR_RELAYER_SECRET=
STELLAR_ADMIN_SECRET=

# Worker reconciliation loop.
WORKER_INTERVAL_MS=10000
# Event scanning stays off until a start ledger is set.
WORKER_EVENT_START_LEDGER=
WORKER_EVENT_LIMIT=

# Lira, and lumens through lira, come from the anchor rather than a market feed.
# The anchor quotes the one asset it ramps (USDC); the Soroswap router prices the
# leg between lumens and that asset, which is the swap a settlement would really
# make. All four are needed or the deployment falls back to the market feed.
ANCHOR_QUOTE_SERVER=https://tr-mock-anchor.fly.dev/sep38
ANCHOR_BRIDGE_ASSET=stellar:USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ANCHOR_BRIDGE_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
SOROSWAP_ROUTER_CONTRACT_ID=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD

# Optional key for the market feed, which now prices only the currencies no
# anchor quotes: dollar, euro and naira. Lira does not depend on it. Without a
# key the feed is rate limited per source IP and those three can disappear;
# lira keeps working either way.
RATE_FEED_API_KEY=
