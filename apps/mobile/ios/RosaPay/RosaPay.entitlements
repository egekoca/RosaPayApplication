<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Without this the Keychain refuses every call with errSecMissingEntitlement,
	  and this app keeps both the session and the wallet's signing key there. The
	  app had no entitlements file at all, so on iOS it could not store a wallet
	  and forgot everything it was told on relaunch.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.rosapay</string>
	</array>
	<!--
	  Passkeys are scoped to a domain, not to an app. Without this the system
	  refuses the prompt before the customer sees anything, and the domain must
	  serve a matching apple-app-site-association naming this app - see
	  apps/web/.well-known/, and docs/passkeys.md for what has to be filled in.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:rosa-pay-app.vercel.app</string>
	</array>
	<!--
	  Lets the app open an NFCTagReaderSession, which is how an iPhone reads the
	  request an Android merchant publishes over NFC. TAG is the raw-tag format;
	  the AID the session is allowed to see is listed in Info.plist under
	  com.apple.developer.nfc.readersession.iso7816.select-identifiers.

	  This is the standard "Near Field Communication Tag Reading" capability and
	  needs no approval from Apple. The other direction does: iOS does not let a
	  third-party app emulate a card, so an iPhone cannot be the merchant over
	  NFC and RosaPayNfc.swift refuses startBroadcast rather than pretending.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!--
	  This is an entitlement, not an Info.plist setting. Without it a signed
	  release can open Core NFC but will not pass Rosa Pay's proprietary ISO-7816
	  tag to the app. Keep it equal to apduservice.xml and RosaPayNfcModule.AID.
	-->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>F0526F736150617901</string>
	</array>
</dict>
</plist>
